# Example secrets file. `make setup` copies it to .env (git-ignored).
# Prefer 1Password references (op://vault/item/field): make targets that need
# secrets run through `op run`, which fills them in. Plain values also work.
# The systemd service (`make install`) needs OP_SERVICE_ACCOUNT_TOKEN for `op`;
# that goes in ~/.config/catpoop/service.env, not here (see docs/service.md#secrets).

# Google Device Access, used by the camera package (googlenestcam).
GOOGLENESTCAM_CLIENT_ID=op://Private/cat-poop-google/client_id
GOOGLENESTCAM_CLIENT_SECRET=op://Private/cat-poop-google/client_secret
GOOGLENESTCAM_PROJECT_ID=op://Private/cat-poop-google/project_id
# Where the camera Token is saved after `login`. Keep it outside the repo.
GOOGLENESTCAM_TOKEN_PATH=/home/you/.config/googlenestcam/token.json

# Google Data Portability API, for `make import-history ARGS=portability`
# (see docs/history-import.md). Client id and secret default to the camera's.
CATPOOP_PORTABILITY_REFRESH_TOKEN=op://Private/cat-poop-portability/refresh_token
# CATPOOP_PORTABILITY_CLIENT_ID=op://Private/cat-poop-portability/client_id
# CATPOOP_PORTABILITY_CLIENT_SECRET=op://Private/cat-poop-portability/client_secret

# Voice Monkey, for [[speakers]] of kind "alexa" (see docs/watcher.md#speaker-alexa).
CATPOOP_VOICE_MONKEY_TOKEN=op://Private/cat-poop-voice-monkey/token
