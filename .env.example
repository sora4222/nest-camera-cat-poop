# Example secrets file. `make setup` copies it to .env (git-ignored).
# Prefer 1Password references (op://vault/item/field): make targets that need
# secrets run through `op run`, which fills them in. Plain values also work.

# Google Device Access, used by the camera package (googlenestcam).
GOOGLENESTCAM_CLIENT_ID=op://Private/cat-poop-google/client_id
GOOGLENESTCAM_CLIENT_SECRET=op://Private/cat-poop-google/client_secret
GOOGLENESTCAM_PROJECT_ID=op://Private/cat-poop-google/project_id
# Where the camera Token is saved after `login`. Keep it outside the repo.
GOOGLENESTCAM_TOKEN_PATH=/home/you/.config/googlenestcam/token.json
